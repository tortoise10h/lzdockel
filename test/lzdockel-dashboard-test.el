(defun lzdockel-test--display-col-of (line substring)
  "Return the display column where SUBSTRING begins in LINE, or nil."
  (let ((idx (string-search substring line)))
    (when idx
      (string-width (substring line 0 idx)))))

(defun lzdockel-test--column-starts (widths)
  "Return plist of expected display column start offsets for WIDTHS."
  (let* ((indent lzdockel-dashboard--container-indent)
         (gap (or (plist-get widths :gap) lzdockel-dashboard--container-gap))
         (id-col indent)
         (image-col (+ id-col (plist-get widths :id) gap))
         (created-col (+ image-col (plist-get widths :image) gap))
         (ports-col (+ created-col (plist-get widths :created) gap))
         (name-col (+ ports-col (plist-get widths :ports) gap))
         (status-col (+ name-col (plist-get widths :name) gap)))
    (list :id id-col
          :image image-col
          :created created-col
          :ports ports-col
          :name name-col
          :status status-col)))

(defun lzdockel-test--render-containers-lines (containers width)
  "Render a dashboard buffer with CONTAINERS at WIDTH and return container lines.
Returns a plist (:header HEADER-LINE :rows ROW-LINES)."
  (with-temp-buffer
    (lzdockel-dashboard-mode)
    (setq lzdockel-dashboard-data (list (cons 0 containers)))
    (lzdockel-dashboard-render width)
    (goto-char (point-min))
    (re-search-forward "^[▸ ] \\[1\\]-Containers$")
    (forward-line 1)
    (let ((header (buffer-substring (line-beginning-position) (line-end-position)))
          (rows '()))
      (dotimes (_ (length containers))
        (forward-line 1)
        (push (buffer-substring (line-beginning-position) (line-end-position)) rows))
      (list :header header :rows (nreverse rows)))))

(ert-deftest lzdockel-format-ports-respects-dynamic-width ()
  (let ((raw "0.0.0.0:8080->80/tcp, [::]:8080->80/tcp, 0.0.0.0:8443->443/tcp, 0.0.0.0:9090->9090/tcp"))
    ;; Without max-width, returns full simplified string (not chopped at 20 chars).
    (should (equal (lzdockel-format-ports raw)
                   "8080→80, 8443→443, 9090→9090"))
    ;; With narrow max-width, truncates cleanly to exact display width using ellipsis.
    (let ((narrow (lzdockel-format-ports raw 12)))
      (should (<= (string-width narrow) 12))
      (should (string-suffix-p "…" narrow)))
    ;; With wide max-width, preserves full port string without truncation.
    (should (equal (lzdockel-format-ports raw 32)
                   "8080→80, 8443→443, 9090→9090"))
    ;; Supports 127.0.0.1 host bindings and exposed ports.
    (should (equal (lzdockel-format-ports "127.0.0.1:5432->5432/tcp, 6379/tcp")
                   "5432→5432, 6379"))
    (should (equal (lzdockel-format-ports "") ""))
    (should (equal (lzdockel-format-ports nil) ""))))

(ert-deftest lzdockel-container-column-widths-responsive ()
  (let ((containers (lzdockel-test--sample-containers)))
    (dolist (w '(60 80 100 120 140 180 240))
      (let* ((widths (lzdockel-dashboard--container-column-widths w containers))
             (gap (plist-get widths :gap))
             (total (+ lzdockel-dashboard--container-indent
                       (plist-get widths :id)
                       (plist-get widths :image)
                       (plist-get widths :created)
                       (plist-get widths :ports)
                       (plist-get widths :name)
                       (plist-get widths :status)
                       (* 5 gap))))
        (should (= (plist-get widths :id) 12))
        (should (<= total w))
        (dolist (k '(:image :created :ports :name :status))
          (should (>= (plist-get widths k) 1)))))
    ;; Wider window allocates strictly more space to Image, Ports, and Name.
    (let ((narrow (lzdockel-dashboard--container-column-widths 80 containers))
          (wide (lzdockel-dashboard--container-column-widths 140 containers)))
      (should (< (plist-get narrow :image) (plist-get wide :image)))
      (should (< (plist-get narrow :ports) (plist-get wide :ports)))
      (should (< (plist-get narrow :name) (plist-get wide :name)))
      (should (>= (plist-get wide :image) (length "quay.io/debezium/connect:2.7.3.Final"))))))

(ert-deftest lzdockel-containers-content-aware-no-bloat-on-wide-screen ()
  (let* ((short-containers
          (list
           `((ID . "5eaf31fb0b50")
             (Image . "redis")
             (RunningFor . "4 months ago")
             (Ports . "0.0.0.0:6379->6379/tcp")
             (Names . "redis")
             (Status . "Exited (255) 30 hours ago"))
           `((ID . "14650568a20e")
             (Image . "postgres:17.10")
             (RunningFor . "5 months ago")
             (Ports . "0.0.0.0:5432->5432/tcp")
             (Names . "rails_development")
             (Status . "Up 2 hours"))))
         (widths (lzdockel-dashboard--container-column-widths 180 short-containers)))
