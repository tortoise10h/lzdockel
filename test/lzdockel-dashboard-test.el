(ert-deftest lzdockel-dashboard-available-width-accounts-for-line-numbers ()
  (let ((buf (get-buffer-create "*lzdockel-test-ln*")))
    (unwind-protect
        (progn
          (set-window-buffer (selected-window) buf)
          (with-current-buffer buf
            (lzdockel-dashboard-mode)
            (setq-local display-line-numbers nil)
            (let ((without-ln (lzdockel-dashboard--available-width (selected-window))))
              (setq-local display-line-numbers 'relative)
              (let ((with-ln (lzdockel-dashboard--available-width (selected-window))))
                (should (< with-ln without-ln))
                (should (>= (- without-ln with-ln) 4))))))
      (kill-buffer buf))))

(ert-deftest lzdockel-dashboard-resize-rerenders-and-preserves-line ()
  (let ((containers (lzdockel-test--sample-containers))
        (mock-width 80))
    (cl-letf (((symbol-function 'lzdockel-dashboard--available-width)
               (lambda (&optional _win) mock-width)))
      (with-temp-buffer
        (lzdockel-dashboard-mode)
        (should (memq #'lzdockel-dashboard--on-window-resize
                      window-size-change-functions))
        (setq lzdockel-dashboard-data (list (cons 0 containers)))
        (lzdockel-dashboard-render)
        (should (= lzdockel-dashboard--last-render-width 80))
        ;; Move to the second container line and simulate a window widen to 140.
        (goto-char (point-min))
        (re-search-forward "b2c3d4e5f6a1")
        (let ((target-line (line-number-at-pos)))
          (setq mock-width 140)
          (lzdockel-dashboard--on-window-resize)
          (should (= lzdockel-dashboard--last-render-width 140))
          (should (= (line-number-at-pos) target-line))
          (should (string-search "quay.io/debezium/connect:2.7.3.Final"
                                 (buffer-string))))))))

(defun lzdockel-test--render-section-lines (section-index section-title items width)
  "Render a dashboard buffer with ITEMS in SECTION-INDEX at WIDTH.
Returns a plist (:header HEADER-LINE :rows ROW-LINES)."
  (with-temp-buffer
    (lzdockel-dashboard-mode)
    (setq lzdockel-dashboard-data (list (cons section-index items)))
    (lzdockel-dashboard-render width)
    (goto-char (point-min))
    (re-search-forward (format "^[▸ ] \\[%d\\]-%s$" (1+ section-index) section-title))
    (forward-line 1)
    (let ((header (buffer-substring (line-beginning-position) (line-end-position)))
          (rows '()))
      (dotimes (_ (length items))
        (forward-line 1)
        (push (buffer-substring (line-beginning-position) (line-end-position)) rows))
      (list :header header :rows (nreverse rows)))))

(ert-deftest lzdockel-networks-alignment-and-truncation ()
  (let ((networks
         (list
          `((ID . "f12ae21c124c9999")
            (Name . "voice-agent-livekit_default")
            (Driver . "bridge")
            (Scope . "local"))
          `((ID . "1122334455667788")
            (Name . "super-long-production-microservice-mesh-overlay-network-name")
            (Driver . "overlay")
            (Scope . "swarm"))
          `((ID . "f53106faf8280000")
            (Name . "bridge")
            (Driver . "bridge")
            (Scope . "local")))))
    ;; At 100 cols: voice-agent-livekit_default aligns cleanly; extra-long name truncates.
    (let* ((width 100)
           (rendered (lzdockel-test--render-section-lines 3 "Networks" networks width))
           (header (plist-get rendered :header))
           (rows (plist-get rendered :rows))
           (driver-col (lzdockel-test--display-col-of header "Driver"))
           (scope-col (lzdockel-test--display-col-of header "Scope")))
      (should (<= (string-width header) width))
      (dolist (row rows)
