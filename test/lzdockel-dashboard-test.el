(ert-deftest lzdockel-containers-preserves-faces-and-text-properties ()
  (let* ((containers (lzdockel-test--sample-containers))
         (width 80)
         (widths (lzdockel-dashboard--container-column-widths width containers))
         (cols (lzdockel-test--column-starts widths)))
    (with-temp-buffer
      (lzdockel-dashboard-mode)
      (should truncate-lines)
      (setq lzdockel-dashboard-data (list (cons 0 containers)))
      (lzdockel-dashboard-render width)
      (goto-char (point-min))
      (re-search-forward "^[▸ ] \\[1\\]-Containers$")
      ;; Row 0 (running, with truncated ports and status).
      (forward-line 2)
      (let* ((bol (line-beginning-position))
             (eol (line-end-position))
             (line (buffer-substring bol eol)))
        (should (equal (get-text-property bol 'lzdockel-item) (nth 0 containers)))
        (should (equal (get-text-property bol 'lzdockel-section) "Containers"))
        ;; ID face.
        (should (eq (get-text-property (+ bol (plist-get cols :id)) 'face)
                    'lzdockel-image-id))
        ;; Ports face (including on ellipsis char at end of truncated ports).
        (let* ((ports-pos (string-search "8083→" line))
               (ports-end (+ ports-pos (1- (plist-get widths :ports)))))
          (should ports-pos)
          (should (eq (get-text-property (+ bol ports-pos) 'face) 'lzdockel-port))
          (should (eq (get-text-property (+ bol ports-end) 'face) 'lzdockel-port)))
        ;; Running status face (including on ellipsis if truncated).
        (let ((status-pos (string-search "Up 3 days" line)))
          (should (eq (get-text-property (+ bol status-pos) 'face) 'lzdockel-status-running))
          (should (eq (get-text-property (1- eol) 'face) 'lzdockel-status-running))))
      ;; Row 2 (exited, dimmed prefix + exited status face).
      (forward-line 2)
      (let* ((bol (line-beginning-position))
             (eol (line-end-position))
             (line (buffer-substring bol eol))
             (status-pos (string-search "Exited" line)))
        (should (equal (get-text-property bol 'lzdockel-item) (nth 2 containers)))
        (should (equal (get-text-property bol 'lzdockel-section) "Containers"))
        (should (eq (get-text-property (+ bol (plist-get cols :id)) 'face)
                    'lzdockel-dashboard-item-dim))
        (should (eq (get-text-property (+ bol status-pos) 'face)
                    'lzdockel-status-exited))))))

