(ert-deftest lzdockel-containers-alignment-and-truncation-narrow-80 ()
  (let* ((width 80)
         (containers (lzdockel-test--sample-containers))
         (widths (lzdockel-dashboard--container-column-widths width containers))
         (cols (lzdockel-test--column-starts widths))
         (rendered (lzdockel-test--render-containers-lines containers width))
         (header (plist-get rendered :header))
         (rows (plist-get rendered :rows)))
    ;; Header fits within 80 cols and each header label starts at expected column.
    (should (<= (string-width header) width))
    (should (= (lzdockel-test--display-col-of header "ID") (plist-get cols :id)))
    (should (= (lzdockel-test--display-col-of header "Image") (plist-get cols :image)))
    (should (= (lzdockel-test--display-col-of header "Created") (plist-get cols :created)))
    (should (= (lzdockel-test--display-col-of header "Ports") (plist-get cols :ports)))
    (should (= (lzdockel-test--display-col-of header "Name") (plist-get cols :name)))
    ;; Every container row fits within 80 cols and aligns strictly with headers.
    (dolist (row rows)
      (should (<= (string-width row) width)))
    ;; Row 0: long Debezium image, long ports, long container name are truncated & aligned.
    (let ((row0 (nth 0 rows)))
      (should (= (lzdockel-test--display-col-of row0 "a1b2c3d4e5f6") (plist-get cols :id)))
      (should (= (lzdockel-test--display-col-of row0 "quay.io/") (plist-get cols :image)))
      (should (string-search "…" row0))
      (should-not (string-search "quay.io/debezium/connect:2.7.3.Final" row0))
      (should (= (lzdockel-test--display-col-of row0 "About an") (plist-get cols :created)))
      (should (= (lzdockel-test--display-col-of row0 "8083→") (plist-get cols :ports)))
      (should (= (lzdockel-test--display-col-of row0 "production-") (plist-get cols :name)))
      (should (= (lzdockel-test--display-col-of row0 "Up 3 days") (plist-get cols :status))))
    ;; Row 1: normal container aligns at exact same columns.
    (let ((row1 (nth 1 rows)))
      (should (= (lzdockel-test--display-col-of row1 "b2c3d4e5f6a1") (plist-get cols :id)))
      (should (= (lzdockel-test--display-col-of row1 "postgres:16") (plist-get cols :image)))
      (should (= (lzdockel-test--display-col-of row1 "2 hours") (plist-get cols :created)))
      (should (= (lzdockel-test--display-col-of row1 "5432→5432") (plist-get cols :ports)))
      (should (= (lzdockel-test--display-col-of row1 "app-postgres") (plist-get cols :name)))
      (should (= (lzdockel-test--display-col-of row1 "Up 2 hours") (plist-get cols :status))))
    ;; Row 2: exited container with empty ports aligns at exact same columns.
    (let ((row2 (nth 2 rows)))
      (should (= (lzdockel-test--display-col-of row2 "c3d4e5f6a1b2") (plist-get cols :id)))
      (should (= (lzdockel-test--display-col-of row2 "redis:7-alpine") (plist-get cols :image)))
      (should (= (lzdockel-test--display-col-of row2 "3 weeks") (plist-get cols :created)))
      (should (= (lzdockel-test--display-col-of row2 "cache-redis") (plist-get cols :name)))
      (should (= (lzdockel-test--display-col-of row2 "Exited") (plist-get cols :status))))))

